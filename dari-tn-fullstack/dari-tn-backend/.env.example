# ============================================================
#  DARI.TN — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Serveur ---
NODE_ENV=production
PORT=3000
APP_URL=https://api.dari.tn
BACKEND_PUBLIC_URL=https://api.dari.tn
FRONTEND_URL=https://dari.tn

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dari_tn
DB_USER=dari_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Comptes initiaux du seed (mots de passe forts et uniques) ---
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_AGENT_PASSWORD=CHANGE_ME_AGENT_PASSWORD
SEED_USER_PASSWORD=CHANGE_ME_USER_PASSWORD

# --- JWT ---
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# --- Cloudinary (stockage photos) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@dari.tn
SMTP_PASS=your_app_password
EMAIL_FROM=Dari.tn <contact@dari.tn>

# --- Flouci (paiement des visites) ---
# Creer ces identifiants depuis le compte marchand Flouci.
FLOUCI_APP_TOKEN=your_flouci_app_token
FLOUCI_APP_SECRET=your_flouci_app_secret
APPOINTMENT_FEE_TND=20

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- CORS ---
ALLOWED_ORIGINS=https://dari.tn,https://www.dari.tn
